//@version=6
// ============================================================================
//  NQ Pre-Market High / Low (4:00 AM - 9:00 AM EST/EDT, hora de Nueva York)
//  - Marca el máximo y el mínimo del rango 4:00-9:00 ET de cada día.
//  - Las líneas se actualizan en vivo durante la sesión y se extienden
//    hasta la hora de corte elegida (por defecto 16:00 ET).
//  - Usa la zona horaria "America/New_York", así que respeta el horario
//    de verano automáticamente.
//  - Recomendado en temporalidades intradía (1m - 1h).
// ============================================================================
indicator("NQ Pre-Market High/Low (4-9 AM ET)", shorttitle = "PM H/L", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ---------------------------------------------------------------- Inputs ----
grpS = "Sesión"
sessInput = input.session("0400-0900", "Rango (hora NY)", group = grpS)
endHour   = input.int(16, "Extender líneas hasta (hora)", minval = 0, maxval = 23, group = grpS)
endMinute = input.int(0, "Extender líneas hasta (minuto)", minval = 0, maxval = 59, group = grpS)
maxDays   = input.int(5, "Días a mostrar", minval = 1, maxval = 100, group = grpS)

grpV = "Estilo"
colHigh    = input.color(color.new(color.teal, 0), "Color High", group = grpV)
colLow     = input.color(color.new(color.red, 0), "Color Low", group = grpV)
showMid    = input.bool(false, "Mostrar nivel medio (50%)", group = grpV)
colMid     = input.color(color.new(color.gray, 0), "Color Medio", group = grpV)
showBox    = input.bool(true, "Sombrear el rango 4-9 AM", group = grpV)
colBox     = input.color(color.new(color.blue, 90), "Color sombreado", group = grpV)
showLabels = input.bool(true, "Mostrar etiquetas con precio", group = grpV)
lineWidth  = input.int(2, "Grosor de línea", minval = 1, maxval = 5, group = grpV)
styleIn    = input.string("Sólida", "Estilo de línea", options = ["Sólida", "Discontinua", "Punteada"], group = grpV)

// --------------------------------------------------------------- Helpers ----
TZ = "America/New_York"
lineStyle = styleIn == "Sólida" ? line.style_solid : styleIn == "Discontinua" ? line.style_dashed : line.style_dotted

inSess    = not na(time(timeframe.period, sessInput, TZ))
sessStart = inSess and not inSess[1]

// ----------------------------------------------------------------- State ----
var float sH     = na
var float sL     = na
var int   startT = na
var int   endT   = na

var line  hLine = na
var line  lLine = na
var line  mLine = na
var label hLbl  = na
var label lLbl  = na
var box   rBox  = na

var array<line>  allLines  = array.new<line>()
var array<label> allLabels = array.new<label>()
var array<box>   allBoxes  = array.new<box>()

// --------------------------------------------------------------- Logic ------
if sessStart
    sH     := high
    sL     := low
    startT := time
    endT   := timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), endHour, endMinute)
    // Si la hora de corte es antes del inicio, se extiende al día siguiente
    if endT <= startT
        endT += 24 * 60 * 60 * 1000

    hLine := line.new(startT, sH, endT, sH, xloc.bar_time, color = colHigh, style = lineStyle, width = lineWidth)
    lLine := line.new(startT, sL, endT, sL, xloc.bar_time, color = colLow,  style = lineStyle, width = lineWidth)
    allLines.push(hLine)
    allLines.push(lLine)

    if showMid
        mLine := line.new(startT, (sH + sL) / 2, endT, (sH + sL) / 2, xloc.bar_time, color = colMid, style = line.style_dotted, width = 1)
        allLines.push(mLine)
    else
        mLine := na

    if showBox
        rBox := box.new(startT, sH, time_close, sL, xloc = xloc.bar_time, border_width = 0, bgcolor = colBox)
        allBoxes.push(rBox)
    else
        rBox := na

    if showLabels
        hLbl := label.new(endT, sH, "PM High " + str.tostring(sH, format.mintick), xloc.bar_time,
             color = color(na), style = label.style_label_left, textcolor = colHigh, size = size.small)
        lLbl := label.new(endT, sL, "PM Low " + str.tostring(sL, format.mintick), xloc.bar_time,
             color = color(na), style = label.style_label_left, textcolor = colLow, size = size.small)
        allLabels.push(hLbl)
        allLabels.push(lLbl)
    else
        hLbl := na
        lLbl := na

    // Limpiar días viejos
    linesPerDay = showMid ? 3 : 2
    while allLines.size() > maxDays * linesPerDay
        allLines.shift().delete()
    while allLabels.size() > maxDays * 2
        allLabels.shift().delete()
    while allBoxes.size() > maxDays
        allBoxes.shift().delete()

else if inSess
    sH := math.max(sH, high)
    sL := math.min(sL, low)
    hLine.set_y1(sH), hLine.set_y2(sH)
    lLine.set_y1(sL), lLine.set_y2(sL)
    if not na(mLine)
        mLine.set_y1((sH + sL) / 2), mLine.set_y2((sH + sL) / 2)
    if not na(rBox)
        rBox.set_top(sH), rBox.set_bottom(sL), rBox.set_right(time_close)
    if not na(hLbl)
        hLbl.set_y(sH), hLbl.set_text("PM High " + str.tostring(sH, format.mintick))
        lLbl.set_y(sL), lLbl.set_text("PM Low " + str.tostring(sL, format.mintick))

// ------------------------------------------------- Data window / Alertas ----
plot(sH, "PM High", colHigh, display = display.data_window)
plot(sL, "PM Low",  colLow,  display = display.data_window)

afterSess = not inSess and not na(sH) and time <= endT
crossUp   = ta.crossover(close, sH)
crossDn   = ta.crossunder(close, sL)
alertcondition(afterSess and crossUp,  "Ruptura PM High", "NQ rompió el PM High (4-9 AM ET)")
alertcondition(afterSess and crossDn, "Ruptura PM Low",  "NQ rompió el PM Low (4-9 AM ET)")

// Aviso si la temporalidad es demasiado grande
if barstate.islast and timeframe.in_seconds() > 3600
    var label warn = label.new(bar_index, high, "PM H/L: usa una temporalidad ≤ 1h", color = color.orange, textcolor = color.white, style = label.style_label_down)
